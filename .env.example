To save you the stress of setting up the application locally, here is the env.example needed to run the project
PROFILE=local
NODE_ENV=development

PORT=5432

JWT_SECRET=someSecrets
JWT_EXPIRY_TIMEFRAME=3600


REDIS_HOST=localhost
REDIS_PORT=6379

DB_TYPE=postgres
DB_USERNAME=postgres
DB_PASSWORD=chibueze
DB_HOST=localhost
DB_DATABASE=hng_boilerplate_nestjs
DB_ENTITIES=dist/src/modules/**/entities/**/*.entity{.ts,.js}

DB_MIGRATIONS=dist/db/migrations/*{.ts,.js}

JWT_SECRET=someSecrets
JWT_EXPIRY_TIMEFRAME=3600

ADMIN_SECRET_KEY=sometext

GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SERVER_NAME=api
SMTP_USER=
SMTP_PASSWORD=